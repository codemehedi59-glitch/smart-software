{
  "name": "smart-diagnostic-reception-manager",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "build": "vite build",
    "build:web": "cross-env BUILD_TARGET=web vite build --base=/",
    "build:android": "cross-env BUILD_TARGET=android vite build --base=./",
    "android:sync": "npm run build:android && cap sync android",
    "dist": "npm run build && electron-builder --win nsis",
    "android:setup": "npm run build:android && cap add android && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@vitejs/plugin-react": "^6.1.0",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "vite-plugin-pwa": "^2.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.smartdiagnostic.reception",
    "productName": "Smart Diagnostic Reception Manager",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
